# Root .gitignore (per-package .gitignore files also apply in backend/ and frontend/)

# Dependencies
node_modules/

# Build outputs
dist/
.next/
out/
build/
*.tsbuildinfo

# Environment — keep *.example files, ignore real secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
