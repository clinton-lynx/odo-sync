# ---- Backend environment ----
# Copy to `.env` and fill in real values:  cp .env.example .env

# PostgreSQL connection string (local Docker, or a hosted instance like Neon/Supabase)
DATABASE_URL="postgresql://odosync:odosync@localhost:5432/odosync?schema=public"

# HTTP port the API server listens on
PORT=4000

# Origin allowed by CORS (the frontend dev server)
CORS_ORIGIN="http://localhost:3000"

# ---- CALL-E integration ----
# Get a key from https://dashboard.heycall-e.com/account/api-keys
# Leave BLANK to run the scheduler in DRY-RUN mode (logs calls instead of dialing real numbers).
CALLE_API_KEY=""
# Optional base URL override (defaults to the SDK's production endpoint)
# CALLE_BASE_URL="https://api.heycall-e.com"

# ---- Scheduler ----
# node-cron expression controlling how often due CallJobs are checked/fired.
# Default: every minute (good for demos). Example for hourly: "0 * * * *"
SCHEDULER_CRON="* * * * *"
# Set to "false" to disable the in-process scheduler (e.g. when running scheduler standalone)
SCHEDULER_ENABLED="true"

# Days between services — used to compute the next due date at close-out.
SERVICE_INTERVAL_DAYS=180
